# Copy to .env.local — never commit real values (.env* gitignored except this file)

# LLM engines (server-only)
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Optional: point the OpenAI client at any OpenAI-compatible endpoint
# (Azure OpenAI v1, Groq, ...) and override the model to match the deployment.
# Defaults: https://api.openai.com/v1 + gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MODEL=

# Supabase — anon key is client-safe (RLS enforced); service role is server-only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only except publishable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs — created once by `npx tsx --env-file=.env.local scripts/stripe-setup.ts`
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# Email (Resend). EMAIL_FROM defaults to onboarding@resend.dev for local dev;
# set a verified sending domain in production. NEXT_PUBLIC_APP_URL is the base
# for links in emails.
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=

# Worker auth + cost circuit breaker (§2.5)
CRON_SECRET=
MAX_DAILY_LLM_USD=20
