  "narrative": {
    "northStar": "The Prism — one question in, three engine answers out.",
    "overview": "First Chair records what ChatGPT, Gemini and Perplexity say about a law firm. The identity is the instrument that splits one question into three answers, chosen to be operable at data density rather than atmospheric. It replaces Editorial Law Review, a legal-publishing metaphor that could not carry six chart series, a dark mode, or a per-engine colour system.",
    "keyCharacteristics": [
      "Indigo means the user's own firm and nothing else.",
      "Each engine owns one hue permanently, plus a line style so colour is never the only cue.",
      "Graphic hues and text hues are separate values; the mark colour does not pass AA as small text.",
      "Every colour pair is verified by a test that parses globals.css and fails the build on regression.",
      "Dark is a peer mode: shadows off, elevation by border.",
      "Motion is decided by frequency — seen constantly means no animation.",
      "Two registers: marketing may be expressive, the product is quiet and dense."
    ],
    "rules": [
      {
        "name": "Indigo Means You",
        "body": "brand-500 identifies the user's own firm and nothing else.",
        "section": "Colour"
      },
      {
        "name": "One Hue Per Engine",
        "body": "ChatGPT emerald, Gemini azure, Perplexity rose, everywhere, forever.",
        "section": "Colour"
      },
      {
        "name": "Graphic Hue, Text Hue",
        "body": "The engine mark colour is for strokes and fills; the -text variant is for words.",
        "section": "Colour"
      },
      {
        "name": "Never Colour Alone",
        "body": "Every colour-coded distinction carries a second cue. Charts must survive greyscale.",
        "section": "Colour"
      },
      {
        "name": "Measured, Not Eyeballed",
        "body": "A pair enters the system only after the contrast test passes.",
        "section": "Colour"
      },
      {
        "name": "Mono Means Verbatim",
        "body": "JetBrains Mono is reserved for what a machine actually said.",
        "section": "Typography"
      },
      {
        "name": "Tabular Figures",
        "body": "Any number that updates is tabular-nums.",
        "section": "Typography"
      },
      {
        "name": "Focus Is Never Removed",
        "body": "Only restyled.",
        "section": "Accessibility"
      },
      {
        "name": "Frequency Decides Motion",
        "body": "Seen constantly means no animation; seen rarely earns delight.",
        "section": "Motion"
      },
      {
        "name": "Components, Not Call Sites",
        "body": "Anything used more than twice becomes a class.",
        "section": "Components"
      },
      {
        "name": "Two Registers",
        "body": "Marketing may be expressive. The product is quiet and fast.",
        "section": "Overview"
      }
    ],
    "dos": [
      "Pair every colour signal with a word, sign, arrow or line style.",
      "Use the -text engine variant whenever the hue carries words.",
      "Put a border-input boundary on anything the user can operate.",
      "Set verbatim engine output in mono.",
      "Give every pressable element the scale(0.97) press.",
      "Keep numbers tabular.",
      "Design both themes at once; check the dark ground before shipping.",
      "Reach for an existing .ds- class before writing a new style.",
      "Let the contrast test decide, not the eye."
    ],
    "donts": [
      "No chart colour outside series-1 to 6 and the engine hues.",
      "No raw hex in JSX.",
      "No emoji in the interface.",
      "No rounded-full outside avatars and status dots.",
      "No shadow in dark mode.",
      "No text-white as a generic light colour.",
      "No fifth container width.",
      "No font size off the ramp.",
      "No animation on a keyboard-initiated action.",
      "No legacy Editorial token in new work.",
      "Never ease-in on a UI transition.",
      "Never enter an element from scale(0)."
    ]
  }
}
